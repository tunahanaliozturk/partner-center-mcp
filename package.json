{
  "name": "partner-center-mcp",
  "version": "0.11.0",
  "description": "Unofficial MCP server: knowledge and codegen assistant for the Partner Center REST API (not affiliated with Microsoft)",
  "type": "module",
  "license": "MIT",
  "mcpName": "io.github.tunahanaliozturk/partner-center-mcp",
  "author": "Tunahan Ali Ozturk <ozturktunahanali@gmail.com>",
  "homepage": "https://github.com/tunahanaliozturk/partner-center-mcp#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tunahanaliozturk/partner-center-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/tunahanaliozturk/partner-center-mcp/issues"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "partner-center",
    "microsoft",
    "azure",
    "csp",
    "cloud-solution-provider",
    "rest-api",
    "typescript",
    "claude",
    "llm",
    "ai"
  ],
  "bin": {
    "partner-center-mcp": "dist/index.js",
    "partner-center-mcp-http": "dist/http.js"
  },
  "files": [
    "dist",
    "data",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "check-docs": "node scripts/check-docs.mjs",
    "check-docs:update": "node scripts/check-docs.mjs --update",
    "lint": "biome check --error-on-warnings .",
    "lint:fix": "biome check --error-on-warnings --write .",
    "eval": "node scripts/eval.mjs",
    "eval:llm": "node scripts/eval-llm.mjs",
    "export": "node scripts/export.mjs",
    "start": "node dist/index.js",
    "start:http": "node dist/http.js"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.5",
    "@types/node": "^20.19.43",
    "@vitest/coverage-v8": "^4.1.10",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "@hono/node-server": "^2.0.5"
  }
}
